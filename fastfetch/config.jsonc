{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/cachyos-linux.png",
        "height": 16,
        "padding":{
            "top":1,
            "right":4
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "cyan"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        "separator",
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "  Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "  Packages",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "cyan"
        },
        {
            "type": "de",
            "key": "  DE",
            "keyColor": "green"
        },

        "break",

        {
            "type": "wm",
            "key": "  WM",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "  Terminal",
            "keyColor": "green"
        },
        "break",
        {
            "type": "cpu",
            "key": "  CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "  GPU",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "  Memory",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "  Disk",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
